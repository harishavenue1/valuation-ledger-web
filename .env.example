# Copy to .env (for `vercel dev`) and fill in.
# Postgres connection string — from Vercel Postgres / Neon / Supabase.
DATABASE_URL=postgres://user:password@host:5432/dbname
# Shared password gate for the whole app (same threat model as the old
# Streamlit app's password — one shared secret, not per-user accounts).
APP_PASSWORD=change-me
