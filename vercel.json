{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/watchlist_detail.py": { "maxDuration": 60 },
    "api/refresh_price.py": { "maxDuration": 300 },
    "api/fetch_company.py": { "maxDuration": 300 },
    "api/momentum_screeners.py": { "maxDuration": 300 },
    "api/viraj_screen.py": { "maxDuration": 300 }
  },
