{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/watchlist_detail.py": {
      "maxDuration": 60,
      "excludeFiles": "{public/audio/**,dist/**,node_modules/**}"
    },
    "api/refresh_price.py": {
      "maxDuration": 300,
      "excludeFiles": "{public/audio/**,dist/**,node_modules/**}"
    },
    "api/fetch_company.py": {
      "maxDuration": 300,
      "excludeFiles": "{public/audio/**,dist/**,node_modules/**}"
    },
    "api/momentum_screeners.py": {
      "maxDuration": 300,
      "excludeFiles": "{public/audio/**,dist/**,node_modules/**}"
    },
    "api/viraj_screen.py": {
      "maxDuration": 300,
      "excludeFiles": "{public/audio/**,dist/**,node_modules/**}"
    },
    "api/*.py": {
      "excludeFiles": "{public/audio/**,dist/**,node_modules/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/refresh_price",
      "schedule": "15 10 * * *"
    },
    {
      "path": "/api/momentum_screeners?screener=ratesFx",
      "schedule": "40 10 * * *"
    },
    {
      "path": "/api/momentum_screeners?screener=bhavDaily",
      "schedule": "30 13 * * 1-5"
    },
    {
      "path": "/api/momentum_screeners?screener=dbVacuum",
      "schedule": "0 1 * * 0"
    }
  ]
}