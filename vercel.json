{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/watchlist_detail.py": { "maxDuration": 60 },
    "api/refresh_price.py": { "maxDuration": 300 },
    "api/fetch_company.py": { "maxDuration": 300 },
    "api/momentum_screeners.py": { "maxDuration": 300 },
    "api/viraj_screen.py": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/refresh_price", "schedule": "15 10 * * *" },
    { "path": "/api/fetch_company", "schedule": "30 23 * * 6" },
    { "path": "/api/momentum_screeners?screener=Nifty500RelativeStrength", "schedule": "20 10 * * *" },
    { "path": "/api/momentum_screeners?screener=nseScreener", "schedule": "22 10 * * *" },
    { "path": "/api/momentum_screeners?screener=sectorAlpha", "schedule": "24 10 * * *" },
    { "path": "/api/momentum_screeners?screener=sectorStockAlpha", "schedule": "26 10 * * *" },
    { "path": "/api/momentum_screeners?screener=maBreakout", "schedule": "28 10 * * *" },
    { "path": "/api/momentum_screeners?screener=grandfatherFatherSon", "schedule": "29 10 * * *" },
    { "path": "/api/momentum_screeners?screener=52wHigh", "schedule": "31 10 * * *" },
